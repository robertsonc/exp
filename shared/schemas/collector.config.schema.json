{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collector.config.schema.json",
  "title": "exp.collector.config/1",
  "description": "Collector config (01 section 9.2). Creds (ingest_tokens.json, dashboard_tokens.json, webhooks.json) and the locally generated TLS key are never in this document.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "exp.collector.config/1"
    },
    "collector_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "site": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "listen": {
      "$ref": "common.schema.json#/$defs/hostport"
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "probe_id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "site": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "label": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "probe_id",
          "site"
        ]
      },
      "maxItems": 1000
    },
    "dashboards": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/slug"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "retention": {
      "type": "object",
      "properties": {
        "metrics_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "records_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    },
    "vm": {
      "type": "object",
      "properties": {
        "listen": {
          "$ref": "common.schema.json#/$defs/loopback_hostport"
        },
        "memory_allowed_pct": {
          "type": "integer",
          "minimum": 5,
          "maximum": 90
        }
      },
      "description": "VictoriaMetrics is never exposed: listen must be loopback."
    },
    "rules": {
      "type": "object",
      "properties": {
        "edge_label": {
          "type": "string",
          "maxLength": 16
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/line_key"
          },
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true
        }
      }
    },
    "alerts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "board_url": {
          "$ref": "common.schema.json#/$defs/https_url"
        },
        "timezone": {
          "$ref": "common.schema.json#/$defs/timezone"
        },
        "voice": {
          "$ref": "common.schema.json#/$defs/voice"
        },
        "hold_down_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "hold_back_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "reopen_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "calm_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "webhook_allow": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9.:/-]+$"
          },
          "description": "Optional allowlist for webhook destinations that resolve to private/loopback/link-local addresses (SR-15). Each entry is an IP address, a CIDR or a host name (exact, case-insensitive). An entry permits only the matching addresses/host; https and no-redirects stay mandatory."
        }
      }
    },
    "reflector": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "iperf3": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingest": {
      "type": "object",
      "properties": {
        "max_body_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "description": "Cannot be raised above the contract limits (4 MiB, 1000 lines)."
    },
    "speedtests": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "speedtests": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "maxItems": 8,
          "description": "Speedtest component ids allowed to hold an exps_ token (creds speedtest_tokens.json {speedtest_id: sha256})."
        },
        "runners": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "maxItems": 8,
          "description": "Runner ids allowed to hold an expr_ token (creds runner_tokens.json {runner_id: sha256})."
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "Tests, device metadata, evidence (default 30). VM aggregates are kept forever."
        },
        "scrub_after_diagnosis": {
          "type": "boolean",
          "description": "Drop raw IP/MAC/username/hostname after the final diagnosis, keep device_key (default false)."
        },
        "targets": {
          "type": "object",
          "properties": {
            "down_mbps": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 100000
            },
            "up_mbps": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 100000
            }
          },
          "additionalProperties": false,
          "description": "Score targets (the collector recomputes scores; default 25 / 10)."
        },
        "max_evidence_kib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 256,
          "description": "Serialized evidence per test (default and maximum 256)."
        },
        "stream_replay_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600,
          "description": "SSE replay window for speedtests/stream (default 300)."
        }
      },
      "additionalProperties": false,
      "description": "M6 speedtest storage, diagnosis and privacy (12 sections 5.3, 6, 9). Creds: speedtest_tokens.json, runner_tokens.json (sha256 maps, str or [current, previous] like the other token files), optional device_key_secret (expk_; lets the purge tool match a MAC against scrubbed rows)."
    }
  },
  "required": [
    "schema",
    "collector_id",
    "site",
    "listen",
    "probes",
    "dashboards"
  ]
}
