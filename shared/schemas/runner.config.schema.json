{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runner.config.schema.json",
  "title": "exp.runner.config/1",
  "description": "Runner config (01 section 9.4, M5). The runner re-checks every drill target against its own allowlist before acting. Creds (integrations.json, ingest_token) are never in this document.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "exp.runner.config/1"
    },
    "runner_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "site": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "collector": {
      "$ref": "probe.config.schema.json#/$defs/collector_ref"
    },
    "drills_enabled": {
      "type": "boolean"
    },
    "pullers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "mist",
              "ec"
            ]
          },
          "interval_s": {
            "type": "integer",
            "minimum": 10,
            "maximum": 86400
          },
          "site_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            },
            "maxItems": 64
          }
        },
        "required": [
          "source",
          "interval_s"
        ]
      },
      "maxItems": 8
    },
    "allowlist": {
      "type": "object",
      "properties": {
        "ec": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nePk": {
                "type": "string",
                "maxLength": 128
              },
              "interfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64
                },
                "maxItems": 32
              },
              "vrrp_groups": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                },
                "maxItems": 32
              }
            },
            "required": [
              "nePk"
            ]
          },
          "maxItems": 256
        }
      }
    },
    "drills": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/drill_assignment"
      },
      "maxItems": 32
    }
  },
  "required": [
    "schema",
    "runner_id",
    "site",
    "collector",
    "drills_enabled"
  ]
}
