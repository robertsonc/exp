[Unit]
Description=exp host agent (declarative, bounded)
Documentation=https://github.com/example-org/exp/blob/main/docs/spec/06-agent.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# `current` is flipped by self-update; install.sh creates /opt/exp and /etc/exp before the first start.
ExecStart=/opt/exp/agent/current/bin/exp-agent run --config /etc/exp/agent.json
Restart=always
RestartSec=5
TimeoutStopSec=30
User=root
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=exp
RuntimeDirectory=exp
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/exp /etc/exp /var/lib/exp /run/exp /etc/systemd/system

[Install]
WantedBy=multi-user.target
