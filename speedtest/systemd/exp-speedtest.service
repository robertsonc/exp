[Unit]
Description=exp speedtest box @VERSION@ (page, API, on-network leg, DNS-leg authority, path timer)
Documentation=file://@PREFIX@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exp-speedtest
Group=exp-speedtest
ExecStart=@PREFIX@/bin/exp-speedtest run --config @CONFIG@
Restart=always
RestartSec=2
TimeoutStopSec=20
# Credentials: the agent guarantees each file exists (possibly empty). Read with exp_common.creds from
# $CREDENTIALS_DIRECTORY; never in config, argv or logs. tls.crt/tls.key are only used when tls.mode = provided.
LoadCredential=collector_token:@CREDS@/collector_token
LoadCredential=runner_channel_token_sha256:@CREDS@/runner_channel_token_sha256
LoadCredential=tls.crt:@CREDS@/tls.crt
LoadCredential=tls.key:@CREDS@/tls.key
# /var/lib/exp/speedtest (speedtest.db, payload.bin, runtime.json) and /run/exp/speedtest (status.json for `health`)
StateDirectory=exp/speedtest
StateDirectoryMode=0755
RuntimeDirectory=exp/speedtest
RuntimeDirectoryMode=0755
UMask=0077
LimitNOFILE=8192
# Ports 80/443/53 on serve.listen_ip need CAP_NET_BIND_SERVICE; nothing else is granted (no CAP_NET_RAW: the path timer
# uses unprivileged ICMP sockets, which need net.ipv4.ping_group_range to include this service's group).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
