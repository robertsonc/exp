#!/usr/bin/python3
"""exp-runner entry point. Works in the release tarball (bin/ + lib/ + vendor/) and in the dev tree."""
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_lib = os.path.join(_here, "..", "lib")
if os.path.isdir(_lib):
    sys.path[:0] = [os.path.join(_here, "..", "lib"), os.path.join(_here, "..", "vendor")]
else:
    _repo = os.path.join(_here, "..", "..")
    sys.path[:0] = [os.path.join(_repo, "runner"), os.path.join(_repo, "shared", "python")]

from exp_runner.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
