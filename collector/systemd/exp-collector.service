[Unit]
Description=exp collector @VERSION@ (ingest, records, rules, query API)
Documentation=file://@PREFIX@/README.md
After=network-online.target exp-victoriametrics.service
Wants=network-online.target exp-victoriametrics.service

[Service]
Type=simple
User=exp-collector
Group=exp-collector
ExecStart=@PREFIX@/bin/exp-collector run --config @CONFIG@
Restart=always
RestartSec=2
TimeoutStopSec=30
# Credentials: the agent guarantees each file exists (possibly empty). Read with exp_common.creds
# from $CREDENTIALS_DIRECTORY; never in config, argv or logs.
LoadCredential=ingest_tokens.json:@CREDS@/ingest_tokens.json
LoadCredential=dashboard_tokens.json:@CREDS@/dashboard_tokens.json
LoadCredential=webhooks.json:@CREDS@/webhooks.json
# M6 speedtest analytics: exps_ / expr_ token digests and the optional per-org device_key secret (empty when unused)
LoadCredential=speedtest_tokens.json:@CREDS@/speedtest_tokens.json
LoadCredential=runner_tokens.json:@CREDS@/runner_tokens.json
LoadCredential=device_key_secret:@CREDS@/device_key_secret
# /var/lib/exp/collector (records.db, tls/, vm/) and /run/exp/collector (health snapshot)
StateDirectory=exp/collector
StateDirectoryMode=0755
RuntimeDirectory=exp/collector
RuntimeDirectoryMode=0755
UMask=0077
# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
