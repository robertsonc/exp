[Unit]
Description=EXM probe: connect Silicom bypass ports (out of Disconnect/Bypass mode)
Documentation=file:///opt/exm/README.md
Before=exm-netns.service
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/exm/bin/exm-bypass-connect

[Install]
WantedBy=multi-user.target
