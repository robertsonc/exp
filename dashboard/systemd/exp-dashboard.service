[Unit]
Description=exp dashboard @VERSION@
Documentation=https://github.com/exp/exp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exp-dashboard
Group=exp-dashboard
ExecStart=@PREFIX@/bin/exp-dashboard run --config @CONFIG@
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# state (sessions.db, tls/) and runtime (health socket) are created and owned by systemd
StateDirectory=exp/dashboard
StateDirectoryMode=0700
RuntimeDirectory=exp/dashboard
RuntimeDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# credentials: the agent guarantees each file exists (possibly empty)
LoadCredential=collector_tokens.json:@CREDS@/collector_tokens.json
LoadCredential=sso_secret:@CREDS@/sso_secret
LoadCredential=local_users.json:@CREDS@/local_users.json
LoadCredential=noc_tokens.json:@CREDS@/noc_tokens.json
LoadCredential=tls.key:@CREDS@/tls.key
LoadCredential=tls.crt:@CREDS@/tls.crt

# ports 443 and 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# hardening (04-dashboard.md section 1)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=@STATE@ @RUN@
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
