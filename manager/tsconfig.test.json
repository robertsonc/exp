{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "node"
    ],
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "worker/src/**/*.ts",
    "worker/.generated/*.ts",
    "worker/test/**/*.ts",
    "vitest.config.ts",
    "vitest.perf.config.ts",
    "vitest.shared.ts"
  ]
}
