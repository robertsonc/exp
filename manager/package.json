{
  "name": "exp-manager",
  "version": "0.1.0",
  "private": true,
  "description": "exp central manager (Cloudflare Worker)",
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && node scripts/build-check.mjs",
    "typecheck": "node scripts/prepare.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "seed:demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/seed-demo.ts",
    "deploy": "./deploy.sh",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:deploy": "bash scripts/test-deploy-dryrun.sh"
  },
  "dependencies": {
    "hono": "4.13.19",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261118.1",
    "@types/node": "22.15.17",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.124.0"
  }
}
