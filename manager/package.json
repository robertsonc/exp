{
  "name": "exp-manager",
  "version": "0.1.0",
  "private": true,
  "description": "exp central manager (Cloudflare Worker)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node scripts/prepare.mjs && wrangler dev",
    "seed:demo": "node scripts/seed-demo.mjs",
    "deploy": "./deploy.sh"
  },
  "dependencies": {
    "hono": "4.13.19",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261118.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.124.0",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12"
  }
}
