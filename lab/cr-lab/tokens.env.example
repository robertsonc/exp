# Copy to tokens.env (gitignored, 0600) and paste one enrol token per node from the manager's Add host page.
# Tokens are single-use and expire; delete tokens.env after scripts/enrol.sh has run.
# Enrol the collector first: the other roles need its address and TLS pin.
collector=
box=
dash=
probe-a=
probe-b=
probe-c=
