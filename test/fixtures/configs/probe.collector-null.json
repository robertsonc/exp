{
  "schema": "exp.probe.config/1",
  "probe_id": "probe-a1",
  "site": "hall-b",
  "collector": null,
  "mode": "netns",
  "mgmt_iface": "eno1",
  "ports": [
    {
      "id": "c01",
      "iface": "enp10s0f0",
      "role": "client",
      "vlan": null,
      "dhcp": {
        "hostname": "exp-hallb-c01",
        "vendor_class": "exp-probe",
        "client_id": "mac"
      }
    },
    {
      "id": "s01",
      "iface": "enp130s1f0",
      "role": "target",
      "address": "10.1.0.250/24",
      "gateway": "10.1.0.1",
      "serve": {
        "http": true,
        "https": true,
        "icmp": true,
        "reflector": true,
        "iperf3": false
      },
      "faults_allowed": true
    }
  ],
  "heartbeat": {
    "interval_s": 10,
    "gateway": true,
    "dhcp": true,
    "dns": true,
    "trace": {
      "target": "8.8.8.8",
      "pace_ms": 20,
      "max_hops": 30,
      "timeout_s": 2,
      "control_path": true
    },
    "ping": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "dns_names": [
      "google.com",
      "apple.com",
      "microsoft.com",
      "cloudflare.com"
    ],
    "alternate_resolver": "1.1.1.1"
  },
  "tests": {
    "dhcp": {
      "interval_s": 300,
      "offer_collect_s": 3.0
    },
    "dns": {
      "interval_s": 300,
      "names": [
        "www.google.com",
        "teams.microsoft.com"
      ]
    },
    "app": {
      "interval_s": 300,
      "targets": [
        {
          "app": "google-search",
          "url": "https://www.google.com/",
          "apdex_t_ms": 500
        }
      ]
    },
    "throughput": {
      "interval_s": 600,
      "providers": [
        "cloudflare"
      ],
      "iperf3": {
        "server": "s01",
        "duration_s": 10
      }
    },
    "path": {
      "interval_s": 60,
      "peers": [
        {
          "peer": "s01",
          "address": "10.1.0.250",
          "port": 8862,
          "proto": [
            "udp",
            "tcp"
          ],
          "duration_s": 10,
          "rate_kbps": 256
        }
      ]
    },
    "wifi": null
  },
  "spool": {
    "max_mb": 500,
    "max_days": 7
  },
  "labels": {
    "zone": "floor-1"
  },
  "drills": []
}
