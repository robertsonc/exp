#!/usr/bin/python3
"""lanctl: the simulated LAN's control and FAULT API (runs inside the net container; the tests call it with
`docker exec <net> lanctl ...`, always argv, never a shell).

  plug LABEL --pid PID --ifname IF --mac MAC [--site N]
                                               veth: one end on the event bridge of site N (default 1; site 2 exists in
                                               the multisite layout), the other moved into the namespace of process PID
                                               as IF (pinned MAC)
  unplug LABEL                                  remove the port
  ports                                         JSON {label: {mac, bridge_if, pid, ifname}}
  block-dns LABEL|all [--resolver-only]         drop UDP+TCP/53 from that port (both the DHCP-given resolver and
                                               the public resolvers; --resolver-only: only 10.1.0.1)
  cut-egress [--at gateway|edge] [--site N]     the router at that hop (of that site) stops forwarding (TTL still
                                               answered, so a traceroute names the last hop that answered)
  gateway-down [--site N]                       the gateway of that site stops answering the LAN altogether: everything
                                               arriving from the event LAN is dropped (ICMP to the gateway, DHCP, DNS,
                                               forwarding): the "Network down" fault
  cut-internet                                  take the WHOLE simulated internet away: the isp namespace (1.1.1.1, 8.8.8.8, every
                                               app server) drops everything on every path (event LANs via the edge AND the
                                               management network), so no site and no host reaches a public address
  restore                                       remove every injected fault (cut-internet included)
  status                                        JSON of the faults currently injected
  canary IP [--site N]                          exit 0 if the resolver at IP answers canary.exp.test (known-good probe)
  hooks-mode CODE|ok / hooks-clear              multisite: make the webhook receiver answer CODE (e.g. 503) / restore 200;
                                               truncate its recorded POSTs (/var/lib/lan/webhooks.jsonl)
  ca                                            print the harness CA certificate (PEM) path
  --- core layout (M6; EXP_LAN_CORE=1) ---
  plug ... --site 3                             plug a port on the core segment (br-core, 10.9.0.0/24)
  client-dhcp --pid P --ifname IF               run a DHCP client in the namespace of process P; prints {ip,router,dns,mask}
  delay --at gateway|edge|wan --ms N            a constant one-way delay on ONE link = +N ms RTT of everything beyond it (no sch_netem
                                               needed: pktdelay.py holds the packets of an NFQUEUE): gateway = core<->gateway (egress
                                               gw-core), edge = gateway<->edge (egress edge-dn), wan = edge<->isp (egress edge-up).
                                               Cumulative per hop: a leg timed to a hop moves only when the delay is on a link at or
                                               before that hop
  delay-clear                                   remove every delay (restore does too)
  delegation on|off                             the gateway resolver forwards the DNS-leg zone to the box / answers NXDOMAIN
  nat-core on|off                               the gateway NATs (masquerades) attendee traffic towards the box: the box then sees the
                                               gateway's core address (10.9.0.1) instead of the attendee's address = the translated
                                               path of A6.12 (a D15 violation: the box placed where the venue NATs); restore turns it off
  fake cf|mist|orch METHOD PATH [JSON]          call a fake's loopback-only /_fake/ control API (cf: fake Cloudflare speed server)
Faults live only in iptables chains EXP_FAULT_* of the gw/gw2/edge namespaces; `restore` flushes them.
"""
from __future__ import annotations

import argparse
import json
import re
import socket
import subprocess
import sys
from pathlib import Path

STATE = Path("/run/lan/ports.json")
HOOKS_LOG = Path("/var/lib/lan/webhooks.jsonl")
HOOKS_MODE = Path("/run/lan/hooks.mode")
GW_NS = {1: "gw", 2: "gw2"}                 # site -> gateway namespace
BRIDGE = {1: "br-ev", 2: "br-ev2"}
PLUG_BRIDGE = {**BRIDGE, 3: "br-core"}      # site 3 = the M6 core segment (plug only)
DNS_ZONE = "t.speed.exp.test"
SERVERS_FILE = Path("/run/lan/gw-servers.conf")
CORE_IP = "10.9.0.10"
NETEM = {"gateway": ("gw", "gw-core"), "edge": ("edge", "edge-dn"), "wan": ("edge", "edge-up")}
FAKES = {"mist": 8485, "orch": 8486}
EDGE_IF = {1: "edge-dn", 2: "edge-dn2"}     # the edge's interface towards that site's gateway
GW_UP = {1: "gw-up", 2: "gw2-up"}
GW_LAN = {1: "gw-ev", 2: "gw-ev2"}
CA = "/run/lan/pki/ca.pem"
GW_ADDR = "10.1.0.1"
LABEL_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,9}\Z")      # bridge-side name is "b-" + label (<= 15 chars)
MAC_RE = re.compile(r"([0-9a-f]{2}:){5}[0-9a-f]{2}\Z")
IFNAME_RE = re.compile(r"[A-Za-z0-9._-]{1,15}\Z")


def run(argv: list[str], check: bool = True) -> subprocess.CompletedProcess[str]:
    r = subprocess.run(argv, capture_output=True, text=True, timeout=30)  # noqa: S603
    if check and r.returncode != 0:
        raise SystemExit(f"lanctl: {' '.join(argv)} failed: {r.stderr.strip() or r.stdout.strip()}")
    return r


def nsx(ns: str, *argv: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return run(["ip", "netns", "exec", ns, *argv], check=check)


def load() -> dict[str, dict]:
    try:
        return json.loads(STATE.read_text())
    except FileNotFoundError:
        return {}


def save(d: dict[str, dict]) -> None:
    STATE.write_text(json.dumps(d, indent=1, sort_keys=True))


def label_ok(label: str) -> str:
    if not LABEL_RE.match(label):
        raise SystemExit(f"lanctl: bad label {label!r} (a-z0-9-, <= 10 chars)")
    return label


def site_ok(site: int) -> int:
    if site not in GW_NS or (site == 2 and not netns_exists("gw2")):
        raise SystemExit(f"lanctl: site {site} does not exist in this LAN")
    return site


def netns_exists(name: str) -> bool:
    return Path("/var/run/netns", name).exists()


def gw_namespaces() -> list[tuple[int, str]]:
    return [(i, n) for i, n in GW_NS.items() if netns_exists(n)]


# ---------------------------------------------------------------------------------------------- ports
def cmd_plug(a: argparse.Namespace) -> None:
    label = label_ok(a.label)
    mac = a.mac.lower()
    if not MAC_RE.match(mac) or not IFNAME_RE.match(a.ifname):
        raise SystemExit("lanctl: bad --mac or --ifname")
    ports = load()
    if label in ports:
        raise SystemExit(f"lanctl: {label} is already plugged")
    if a.site == 3:
        if not netns_exists("gw") or not Path("/sys/class/net/br-core").exists():
            raise SystemExit("lanctl: there is no core segment in this LAN (EXP_LAN_CORE=1)")
        site = 3
    else:
        site = site_ok(a.site)
    br, peer = f"b-{label}", f"q-{label}"
    run(["ip", "link", "add", br, "type", "veth", "peer", "name", peer])
    run(["ip", "link", "set", peer, "address", mac])
    run(["ip", "link", "set", br, "master", PLUG_BRIDGE[site]])
    run(["ip", "link", "set", br, "up"])
    run(["ip", "link", "set", peer, "netns", str(int(a.pid)), "name", a.ifname])
    run(["nsenter", "-t", str(int(a.pid)), "-n", "ip", "link", "set", a.ifname, "up"])
    ports[label] = {"mac": mac, "bridge_if": br, "pid": int(a.pid), "ifname": a.ifname, "site": site}
    save(ports)


def cmd_unplug(a: argparse.Namespace) -> None:
    ports = load()
    p = ports.pop(label_ok(a.label), None)
    if p is None:
        raise SystemExit(f"lanctl: no such port {a.label}")
    run(["ip", "link", "del", p["bridge_if"]], check=False)
    save(ports)


def cmd_ports(_a: argparse.Namespace) -> None:
    print(json.dumps(load(), indent=1, sort_keys=True))


# ---------------------------------------------------------------------------------------------- faults
def cmd_block_dns(a: argparse.Namespace) -> None:
    ports = load()
    labels = sorted(ports) if a.label == "all" else [a.label]
    for label in labels:
        if label not in ports:
            raise SystemExit(f"lanctl: no such port {label}")
    for label in labels:
        mac = ports[label]["mac"]
        gw = GW_NS[ports[label].get("site", 1)]
        for proto in ("udp", "tcp"):
            base = ["-m", "mac", "--mac-source", mac, "-p", proto, "--dport", "53", "-j", "DROP"]
            nsx(gw, "iptables", "-w", "-A", "EXP_FAULT_IN", *base)
            if not a.resolver_only:
                nsx(gw, "iptables", "-w", "-A", "EXP_FAULT_FWD", *base)


def cmd_cut_egress(a: argparse.Namespace) -> None:
    site = site_ok(a.site)
    if a.at == "gateway":
        nsx(GW_NS[site], "iptables", "-w", "-A", "EXP_FAULT_FWD", "-i", GW_LAN[site], "-o", GW_UP[site], "-j", "DROP")
    else:
        nsx("edge", "iptables", "-w", "-A", "EXP_FAULT_FWD", "-i", EDGE_IF[site], "-o", "edge-up", "-j", "DROP")


ISP_NS, ISP_CHAIN = "isp", "EXP_FAULT_NET"


def cmd_cut_internet(_a: argparse.Namespace) -> None:
    """Created lazily (the chain is not in lan-up.sh): INPUT (the simulated hosts live on the isp's loopback),
    FORWARD and OUTPUT of the isp namespace drop everything that is not loopback, whichever interface it uses."""
    if nsx(ISP_NS, "iptables", "-w", "-S", ISP_CHAIN, check=False).returncode != 0:
        nsx(ISP_NS, "iptables", "-w", "-N", ISP_CHAIN)
    for hook in ("INPUT", "FORWARD", "OUTPUT"):
        if nsx(ISP_NS, "iptables", "-w", "-C", hook, "-j", ISP_CHAIN, check=False).returncode != 0:
            nsx(ISP_NS, "iptables", "-w", "-I", hook, "1", "-j", ISP_CHAIN)
    nsx(ISP_NS, "iptables", "-w", "-F", ISP_CHAIN)
    for hook_dir in ("-i", "-o"):
        nsx(ISP_NS, "iptables", "-w", "-A", ISP_CHAIN, hook_dir, "isp-dn", "-j", "DROP")
        nsx(ISP_NS, "iptables", "-w", "-A", ISP_CHAIN, hook_dir, "isp-mg", "-j", "DROP")


def cmd_gateway_down(a: argparse.Namespace) -> None:
    site = site_ok(a.site)
    for chain in ("EXP_FAULT_IN", "EXP_FAULT_FWD"):
        nsx(GW_NS[site], "iptables", "-w", "-A", chain, "-i", GW_LAN[site], "-j", "DROP")


def fault_chains() -> list[tuple[str, tuple[str, ...]]]:
    chains = [(n, ("EXP_FAULT_IN", "EXP_FAULT_FWD")) for _i, n in gw_namespaces()] + [("edge", ("EXP_FAULT_FWD",))]
    if nsx(ISP_NS, "iptables", "-w", "-S", ISP_CHAIN, check=False).returncode == 0:      # only once cut-internet made it
        chains.append((ISP_NS, (ISP_CHAIN,)))
    return chains


def _nat_core_rule(op: str) -> list[str]:
    return ["iptables", "-w", "-t", "nat", op, "POSTROUTING", "-o", "gw-core", "-d", CORE_IP, "-j", "MASQUERADE"]


def _nat_core(on: bool) -> None:
    present = nsx("gw", *_nat_core_rule("-C"), check=False).returncode == 0
    if on and not present:
        nsx("gw", *_nat_core_rule("-A"))
    elif not on and present:
        nsx("gw", *_nat_core_rule("-D"))


def cmd_nat_core(a: argparse.Namespace) -> None:
    _nat_core(a.state == "on")


def cmd_restore(_a: argparse.Namespace) -> None:
    if netns_exists("gw"):
        _nat_core(False)
    for ns, chains in fault_chains():
        for c in chains:
            nsx(ns, "iptables", "-w", "-F", c)
    cmd_delay_clear(_a)
    if SERVERS_FILE.exists():
        _delegation(True)


# ---------------------------------------------------------------------------------------------- M6 core layout
NFQ = {"gateway": 11, "edge": 12, "wan": 13}
RUN_DIR = Path("/run/lan")


def _nfq_rule(at: str, dev: str) -> list[str]:
    return ["-o", dev, "-j", "NFQUEUE", "--queue-num", str(NFQ[at]), "--queue-bypass"]


def _icmp_err_rule(dev: str) -> list[str]:
    """ICMP time-exceeded / unreachable errors a ROUTER generates itself are not held: after a user-space hold they never reach the
    receiver on this kernel (found with `ping -t 2`), and they carry no leg timing (the box times echo replies)."""
    return ["-o", dev, "-p", "icmp", "-m", "icmp", "--icmp-type", "time-exceeded", "-j", "ACCEPT"]


def _delay_off(at: str) -> None:
    ns, dev = NETEM[at]
    pidf = RUN_DIR / f"delay-{at}.pid"
    if netns_exists(ns):
        for rule in (_icmp_err_rule(dev), _nfq_rule(at, dev)):
            while nsx(ns, "iptables", "-w", "-t", "mangle", "-D", "POSTROUTING", *rule, check=False).returncode == 0:
                pass
    if pidf.exists():
        try:
            run(["kill", "-TERM", pidf.read_text().strip()], check=False)
        except OSError:
            pass
        pidf.unlink(missing_ok=True)


def cmd_delay(a: argparse.Namespace) -> None:
    """A constant one-way delay on one egress, held in user space (pktdelay.py over NFQUEUE): kernel-independent, no sch_netem."""
    if not (0 <= a.ms <= 2000):
        raise SystemExit("lanctl: --ms must be 0..2000")
    ns, dev = NETEM[a.at]
    if not netns_exists(ns):
        raise SystemExit("lanctl: no such namespace")
    _delay_off(a.at)
    if a.ms == 0:
        return
    p = subprocess.Popen(["ip", "netns", "exec", ns, sys.executable, "/opt/lan/pktdelay.py", "--queue", str(NFQ[a.at]),
                          "--delay-ms", str(a.ms)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, start_new_session=True)  # noqa: S603
    assert p.stdout is not None
    if p.stdout.readline().strip() != "ready":
        raise SystemExit("lanctl: pktdelay did not start")
    (RUN_DIR / f"delay-{a.at}.pid").write_text(str(p.pid))
    nsx(ns, "iptables", "-w", "-t", "mangle", "-A", "POSTROUTING", *_icmp_err_rule(dev))
    nsx(ns, "iptables", "-w", "-t", "mangle", "-A", "POSTROUTING", *_nfq_rule(a.at, dev))


def cmd_delay_clear(_a: argparse.Namespace) -> None:
    for at in NETEM:
        _delay_off(at)


def _delegation(on: bool) -> None:
    SERVERS_FILE.write_text((f"server=/{DNS_ZONE}/{CORE_IP}\n" if on else f"local=/{DNS_ZONE}/\n"))
    pid = Path("/run/lan/gw-dnsmasq.pid").read_text().strip()
    run(["kill", "-HUP", pid])


def cmd_delegation(a: argparse.Namespace) -> None:
    _delegation(a.state == "on")


def cmd_client_dhcp(a: argparse.Namespace) -> None:
    if not IFNAME_RE.match(a.ifname):
        raise SystemExit("lanctl: bad --ifname")
    r = run(["nsenter", "-t", str(int(a.pid)), "-n", "/usr/local/bin/busybox", "udhcpc", "-i", a.ifname, "-n", "-q", "-f", "-t", "6",
             "-T", "2", "-s", "/opt/lan/udhcpc.script"], check=False)
    out = {}
    for line in r.stdout.splitlines():
        if line.startswith("LEASE "):
            out = dict(kv.split("=", 1) for kv in line[6:].split() if "=" in kv)
    if not out:
        raise SystemExit("lanctl: no DHCP lease: " + (r.stderr or r.stdout)[-300:])
    print(json.dumps(out))


def cmd_fake(a: argparse.Namespace) -> None:
    if not a.path.startswith("/_fake/") or ".." in a.path:
        raise SystemExit("lanctl: only /_fake/ paths")
    argv = ["curl", "-sk", "-m", "20", "-X", a.method.upper(), "-H", "Content-Type: application/json", "-w", "\n%{http_code}"]
    if a.body:
        argv += ["--data-binary", a.body]
    if a.which == "cf":
        argv += ["https://127.0.0.1" + a.path]
        r = nsx("cf", *argv, check=False)
    else:
        argv += [f"https://127.0.0.1:{FAKES[a.which]}" + a.path]
        r = run(argv, check=False)
    body, _, code = r.stdout.rpartition("\n")
    print(body)
    if not code.startswith("2"):
        raise SystemExit(f"lanctl: fake {a.which} answered {code}")


def cmd_status(_a: argparse.Namespace) -> None:
    out: dict[str, list[str]] = {}
    for ns, chains in fault_chains():
        for c in chains:
            rules = nsx(ns, "iptables", "-w", "-S", c).stdout.splitlines()
            out[f"{ns}:{c}"] = [r for r in rules if r.startswith("-A")]
    nat = netns_exists("gw") and nsx("gw", *_nat_core_rule("-C"), check=False).returncode == 0
    print(json.dumps({"faults": out, "nat_core": nat, "active": any(out.values()) or nat}, indent=1))


def cmd_canary(a: argparse.Namespace) -> None:
    """Asked from the gateway namespace: the event-LAN side of the simulation, never affected by a fault that only
    matches a test port's MAC."""
    r = run(["ip", "netns", "exec", GW_NS[site_ok(a.site)], sys.executable, __file__, "_canary", a.ip], check=False)
    if r.returncode != 0:
        raise SystemExit((r.stderr or r.stdout).strip() or "canary failed")


def cmd_canary_raw(a: argparse.Namespace) -> None:
    q = b"\x12\x34\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x06canary\x03exp\x04test\x00\x00\x01\x00\x01"
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(2)
    try:
        s.sendto(q, (a.ip, 53))
        r = s.recv(512)
    except OSError as exc:
        raise SystemExit(f"canary: no answer from {a.ip}: {exc}") from None
    if r[3] & 15 != 0 or r[7] < 1 or r[-4:] != socket.inet_aton("192.0.2.53"):
        raise SystemExit(f"canary: {a.ip} answered, but not with the canary record")


def cmd_hooks_mode(a: argparse.Namespace) -> None:
    if a.code == "ok":
        HOOKS_MODE.unlink(missing_ok=True)
    elif a.code.isdigit() and 100 <= int(a.code) <= 599:
        HOOKS_MODE.write_text(a.code + "\n")
    else:
        raise SystemExit("lanctl: hooks-mode takes an HTTP status code or 'ok'")


def cmd_hooks_clear(_a: argparse.Namespace) -> None:
    HOOKS_LOG.write_text("")


def cmd_ca(_a: argparse.Namespace) -> None:
    print(CA)


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="lanctl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("plug")
    p.add_argument("label")
    p.add_argument("--pid", required=True, type=int)
    p.add_argument("--ifname", required=True)
    p.add_argument("--mac", required=True)
    p.add_argument("--site", type=int, default=1)
    p.set_defaults(fn=cmd_plug)
    p = sub.add_parser("unplug")
    p.add_argument("label")
    p.set_defaults(fn=cmd_unplug)
    sub.add_parser("ports").set_defaults(fn=cmd_ports)
    p = sub.add_parser("block-dns")
    p.add_argument("label")
    p.add_argument("--resolver-only", action="store_true")
    p.set_defaults(fn=cmd_block_dns)
    p = sub.add_parser("cut-egress")
    p.add_argument("--at", choices=("gateway", "edge"), default="gateway")
    p.add_argument("--site", type=int, default=1)
    p.set_defaults(fn=cmd_cut_egress)
    p = sub.add_parser("gateway-down")
    p.add_argument("--site", type=int, default=1)
    p.set_defaults(fn=cmd_gateway_down)
    sub.add_parser("cut-internet").set_defaults(fn=cmd_cut_internet)
    sub.add_parser("restore").set_defaults(fn=cmd_restore)
    p = sub.add_parser("delay")
    p.add_argument("--at", choices=sorted(NETEM), required=True)
    p.add_argument("--ms", type=int, required=True)
    p.set_defaults(fn=cmd_delay)
    sub.add_parser("delay-clear").set_defaults(fn=cmd_delay_clear)
    p = sub.add_parser("delegation")
    p.add_argument("state", choices=("on", "off"))
    p.set_defaults(fn=cmd_delegation)
    p = sub.add_parser("nat-core")
    p.add_argument("state", choices=("on", "off"))
    p.set_defaults(fn=cmd_nat_core)
    p = sub.add_parser("client-dhcp")
    p.add_argument("--pid", required=True, type=int)
    p.add_argument("--ifname", required=True)
    p.set_defaults(fn=cmd_client_dhcp)
    p = sub.add_parser("fake")
    p.add_argument("which", choices=["cf", *sorted(FAKES)])
    p.add_argument("method")
    p.add_argument("path")
    p.add_argument("body", nargs="?")
    p.set_defaults(fn=cmd_fake)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    p = sub.add_parser("canary")
    p.add_argument("ip")
    p.add_argument("--site", type=int, default=1)
    p.set_defaults(fn=cmd_canary)
    p = sub.add_parser("hooks-mode")
    p.add_argument("code")
    p.set_defaults(fn=cmd_hooks_mode)
    sub.add_parser("hooks-clear").set_defaults(fn=cmd_hooks_clear)
    p = sub.add_parser("_canary")
    p.add_argument("ip")
    p.set_defaults(fn=cmd_canary_raw)
    sub.add_parser("ca").set_defaults(fn=cmd_ca)
    a = ap.parse_args(argv)
    a.fn(a)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
